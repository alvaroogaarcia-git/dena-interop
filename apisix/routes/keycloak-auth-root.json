{
  "name": "keycloak-auth-root",
  "uri": "/auth",
  "methods": ["GET", "HEAD", "OPTIONS"],
  "upstream_id": "2",
  "plugins": {
    "proxy-rewrite": {
      "uri": "/",
      "headers": {
        "set": {
          "X-Forwarded-Host": "localhost",
          "X-Forwarded-Port": "30080",
          "X-Forwarded-Proto": "http"
        }
      }
    }
  }
}
