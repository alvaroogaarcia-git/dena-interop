{
  "name": "keycloak-auth-prefix",
  "uri": "/auth/*",
  "methods": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS"],
  "upstream_id": "2",
  "plugins": {
    "proxy-rewrite": {
      "regex_uri": ["^/auth/(.*)", "/$1"],
      "headers": {
        "set": {
          "X-Forwarded-Host": "192.168.56.15",
          "X-Forwarded-Port": "30080",
          "X-Forwarded-Proto": "http"
        }
      }
    }
  }
}
