        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_namespace_name=\"gateway\", k8s_deployment_name=\"apisix\"}",
          "refId": "A"
        }
      ],
      "title": "Logs APISIX",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Logs recientes de PostgREST. Sirven para localizar errores al consultar la base de datos o problemas de configuracion de la API.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "id": 12,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_namespace_name=\"datalake\", k8s_deployment_name=\"postgrest\"}",
          "refId": "A"
        }
      ],
      "title": "Logs PostgREST",
      "type": "logs"
    }
